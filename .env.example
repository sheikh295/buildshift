# Copy to .env and fill in. Never commit .env.

# --- Core ---
COMPOSE_PROJECT_NAME=buildshift
POSTGRES_USER=buildshift
POSTGRES_PASSWORD=buildshift
POSTGRES_DB=buildshift
DATABASE_URL=postgresql+psycopg://buildshift:buildshift@postgres:5432/buildshift

# Absolute path to ./data on the Docker host (Makefile sets this; compose falls back to $PWD/data)
# Required so worker bind-mounts work with docker-from-docker.
# HOST_DATA_DIR=/absolute/path/to/buildshift/data

# Orchestrator bind — keep private on a VPS (localhost or Tailscale IP)
ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=8080

# --- Budgets / concurrency ---
TASK_BUDGET_USD=3.00
DAILY_BUDGET_USD=60.00
MAX_PARALLEL_WORKERS=2
MAX_ATTEMPTS_PER_TIER=2

# --- Worker ---
# mock = no LLM spend (default for first bring-up)
# claude = Claude Code headless via LiteLLM
HARNESS=mock
WORKER_IMAGE=buildshift-worker:local
WORKER_NETWORK=buildshift_default

# --- Proving repo ---
# Leave empty to use fixtures/demo-app (local bare remote under data/)
PROVING_REPO_URL=
PROVING_REPO_BRANCH=main
# If set, push + open GitHub PRs. Required for the real PR path.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# --- LLM gateway (needed when HARNESS=claude) ---
LITELLM_MASTER_KEY=sk-buildshift-local
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: other provider keys your LiteLLM config uses
# DEEPSEEK_API_KEY=

# Default model alias exposed by LiteLLM
DEFAULT_IMPLEMENTER_MODEL=claude-sonnet-4-5
