# Copy to .env and fill in. Never commit .env.
#
# .env = secrets + bootstrap only.
# Day-to-day knobs (models, budgets, harness, parallel, kill, proving defaults)
# are edited in the office Control panel / PUT /control/settings (Postgres).

# --- Core (bootstrap) ---
COMPOSE_PROJECT_NAME=buildshift
POSTGRES_USER=buildshift
POSTGRES_PASSWORD=buildshift
POSTGRES_DB=buildshift
DATABASE_URL=postgresql+psycopg://buildshift:buildshift@postgres:5432/buildshift

# Absolute path to ./data on the Docker host (Makefile sets this; compose falls back to $PWD/data)
# Required so worker bind-mounts work with docker-from-docker.
# HOST_DATA_DIR=/absolute/path/to/buildshift/data

# Orchestrator bind — keep private on a VPS (localhost or Tailscale IP)
ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=8080

# Office UI
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3000
# Shared login token for dashboard + optional orchestrator API auth (empty = open local)
OPERATOR_TOKEN=pass
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# --- Bootstrap defaults (seeded into Control once; change later via Control, not here) ---
TASK_BUDGET_USD=3.00
DAILY_BUDGET_USD=60.00
MAX_PARALLEL_WORKERS=2
MAX_ATTEMPTS_PER_TIER=2
# mock | opencode (LiteLLM/Vercel role models) | claude (Anthropic-compatible; needs INSTALL_CLAUDE=true)
HARNESS=mock
MULTI_ROLE_PIPELINE=true
PROVING_REPO_URL=
PROVING_REPO_BRANCH=main
DEFAULT_IMPLEMENTER_MODEL=minimax-m3.1-flash

# --- Worker image / network (infra) ---
WORKER_IMAGE=buildshift-worker:local
WORKER_NETWORK=buildshift_default

# --- Secrets ---
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
LITELLM_MASTER_KEY=sk-buildshift-local
# Primary LLM upstream (LiteLLM → Vercel AI Gateway)
VERCEL_AI_GATEWAY_API_KEY=
# Optional direct providers if you change litellm config away from the gateway
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=